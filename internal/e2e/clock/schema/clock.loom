service clock

// A service that does nothing but tick: the fixture for `schedule`.

/// How many times the bell has rung.
aggregate Bell {
  state {
    rings: int
  }

  /// Ring the bell once.
  command RingBell -> BellRang

  event BellRang {
    rings: int!
  }
}

/// Rings the bell every second.
schedule bell every 1s -> RingBell @in(tower)

/// Rings the same bell's neighbour, at a stream the schema names.
schedule chime every 1h -> RingBell @in(tower) @id("11111111-2222-4333-8444-555555555555")

/// An anvil, struck hot and left to cool.
aggregate Anvil {
  state {
    cool: bool
  }

  /// Strike the anvil.
  command StrikeAnvil -> AnvilStruck

  /// Record that the anvil has cooled.
  command RecordAnvilCool -> AnvilCooled

  event AnvilStruck {
    cool: bool!
  }

  event AnvilCooled {
    cool: bool!
  }
}

// looks at the anvil until it has cooled: the fixture for loom.NotYet
process coolAnvil @retry(4, 100ms..200ms) {
  on AnvilStruck -> RecordAnvilCool
}

// the same look with nothing to look again with
process impatient {
  on AnvilStruck
}

// settings: the fixture for `setting`

enum Heat { cold warm hot }

/// How many strikes an anvil takes before it is rested.
setting strike_cap: int @default(3)

/// Whether the forge takes work.
setting forge_open: bool @default(true)

/// What drives the bellows.
setting bellows: string @default("hand")

/// How hot the forge is kept.
setting heat: Heat @default(warm)

// no default: the type's zero
setting draught: float

/// A kiln, lit and then watched until its load is fired: the fixture for
/// `@loop`.
aggregate Kiln @loop {
  state {
    lit: bool
    fired: bool
    stokes: int
  }

  /// Light the kiln.
  command LightKiln -> KilnLit

  /// Add fuel.
  command StokeKiln -> KilnStoked

  /// Record that the load is fired.
  command RecordKilnFired -> KilnFired

  event KilnLit {
    lit: bool!
  }

  event KilnStoked {
    stokes: int!
  }

  event KilnFired {
    fired: bool!
  }
}

/// An oven: heated, it must be rested within its deadline; loom keeps
/// the wait.
aggregate Oven @loop {
  state {
    status: string
  }

  /// Start heating.
  command HeatOven -> OvenHeated

  /// Let it rest.
  command RestOven -> OvenRested

  deadline overheat after 2s while status in ("heating")

  event OvenHeated {
    status: string!
  }

  event OvenRested {
    status: string!
  }
}

/// A loaf baking in an oven: the oven supervises its loaves.
aggregate Loaf @loop @supervised_by(Oven, oven_id) {
  state {
    oven_id: uuid
    status: string
  }

  /// Put a loaf in an oven.
  command BakeLoaf {
    oven_id: uuid!
  } -> LoafBaking

  /// Take it out.
  command FinishLoaf -> LoafFinished

  event LoafBaking {
    oven_id: uuid!
  }

  event LoafFinished {
    status: string!
  }
}
