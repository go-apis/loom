service orders

enum OrderStatus { placed shipped cancelled }
/// How soon an order ships.
enum Priority { standard rush }

/// A customer's order, from placed to shipped or cancelled.
aggregate Order @snapshot(5) {
  state {
    status: OrderStatus
    customer_id: uuid
    items: [OrderItem]
    /// The sum of every item's price times its quantity.
    total_cents: int
    currency: string
    shipped_at: timestamp?
    reason: string
    contract: file?
  }

  /// Place a new order for a customer. The total is worked out from
  /// the items.
  ///
  /// An order nobody pays for is cancelled on its own after a while.
  command PlaceOrder {
    customer_id: uuid!
    items: [OrderItem]!
    /// ISO 4217 code the prices are in, for example USD.
    currency: string!
    priority: Priority
    fulfilment: Fulfilment?
  } -> OrderPlaced

  // @role gates the mutation at the gateway: the caller needs one of
  // these roles in the target namespace. In-process dispatch (the
  // shipOnPayment process below) is not gated.
  command ShipOrder @role(owner, shipper) -> OrderShipped
  command CancelOrder -> OrderCancelled

  command RequestContract {
    contract: file!
  } -> ContractRequested

  command AttachContract {
    contract: file!
  } -> ContractAttached

  event OrderPlaced @publish {
    status: OrderStatus!
    customer_id: uuid!
    items: [OrderItem]!
    total_cents: int!
    currency: string!
  }

  event OrderShipped {
    status: OrderStatus!
    shipped_at: timestamp!
  }

  // v2 added `reason`; the upcast below lifts stored v1 rows
  event OrderCancelled @v(2) {
    status: OrderStatus!
    reason: string!
  }

  // a different field name than the state's `contract` on purpose: folds
  // match by name, and a merely-requested upload must not read as attached
  event ContractRequested {
    requested: file!
  }

  event ContractAttached {
    contract: file!
  }

  // signed contracts go straight to blob storage; the domain sees the
  // lifecycle through the two commands
  upload Contract {
    on started -> RequestContract
    on uploaded -> AttachContract
  }
}

// @table: this read model lives in its own typed table
// (loom_t_orders_order_summary) — real columns for filters and BI, items
// riding a jsonb column
entity OrderSummary @table {
  status: OrderStatus
  customer_id: uuid
  total_cents: int
  currency: string
  reason: string
  items: [OrderItem]
  // the customer's newest-first order list (TestMigrateCreatesDeclaredIndexes)
  index (service, namespace, customer_id, updated_at desc nulls last)
  // the status list most dashboards page over, newest first
  // (TestDeclaredQueryMigratesItsIndex)
  query (status, updated_at desc nulls last)
}

projection orderSummary -> OrderSummary {
  on OrderPlaced
  on OrderShipped
  on OrderCancelled
}

// one row per CUSTOMER, folded from many orders' events: key() routes
// each event to the customer's row, @fold hands the counting to code
// assignment folds can't express. The declared joins fan back out: this
// row's id IS the customer id, so list joins collect by customer_id —
// `orders` locally, `invoices` across the bus in billing.
entity CustomerSpend @role(owner) {
  order_count: int
  spend_cents: int
  join orders -> [OrderSummary] via customer_id
  join invoices -> [billing.InvoiceSummary] via customer_id
}

projection customerSpend -> CustomerSpend @fold {
  on OrderPlaced key(customer_id)
}

// billing's InvoicePaid arrives off the bus; the invoice shares the order's
// aggregate id, so the reaction ships that order.
process shipOnPayment {
  on billing.InvoicePaid -> ShipOrder
}

// unpaid orders cancel themselves: placing schedules a CancelOrder timer,
// shipping cancels it
policy scheduleAutoCancel {
  on OrderPlaced -> CancelOrder
}

policy dropAutoCancel {
  on OrderShipped -> CancelOrder
}

consume billing.InvoicePaid {
  paid_at: timestamp
}

// stored v1 OrderCancelled rows predate `reason`
upcast OrderCancelled @from(1)

// series: append-only market-price observations per sku — facts about
// the outside world, bypassing the log entirely. Identity is
// (sku, source, observed_at); re-appending a batch converges.
series SkuPrice @time(observed_at) @dim(sku, source) {
  sku:         string!
  source:      string!
  observed_at: timestamp!
  price_cents: int!
  note:        string
}

// Request latency samples: high volume, worthless after a month.
// @retain makes the table day-partitioned on plain Postgres (expired
// partitions dropped by the runner) and a retention policy on TimescaleDB.
series ReqSample @time(at) @dim(route) @key(sample_id) @retain(30d) {
  sample_id:   uuid!
  route:       string!
  at:          timestamp!
  duration_ms: float!
  status:      int
}

/// A parcel a courier carries for one depot.
// @allow gates by what the caller is: an admin may do anything here, a
// courier only what belongs to its own depot — the reads, the list
// (narrowed to the depot's rows) and both commands.
aggregate Parcel @table @allow(kind: admin) @allow(kind: courier, depot_id: caller.depot) {
  state {
    depot_id: uuid
    label: string
    discarded: bool
    photo: file?
    /// What the parcel is insured for.
    // shown to admins alone: a courier reads the parcel and is told
    // this field is hidden from it, not handed an empty one
    insured_cents: int @allow(kind: admin)
  }

  /// Register a parcel at a depot.
  command RegisterParcel @allow(kind: admin) @allow(kind: courier, depot_id: caller.depot) {
    depot_id: uuid!
    label: string!
    insured_cents: int
  } -> ParcelRegistered

  /// Change what a parcel's label says.
  command RelabelParcel @allow(kind: admin) @allow(kind: courier, depot_id: caller.depot) {
    label: string!
  } -> ParcelRelabelled

  event ParcelRegistered {
    depot_id: uuid!
    label: string!
    insured_cents: int!
  }

  /// Throw a parcel away. It cannot be brought back.
  // @plan: the gateway answers what this would do and runs nothing
  // until the plan's id comes back through runPlan.
  command DiscardParcel @plan @allow(kind: admin) @allow(kind: courier, depot_id: caller.depot) -> ParcelDiscarded

  event ParcelRelabelled {
    label: string!
  }

  event ParcelDiscarded {
    discarded: bool!
  }

  /// Attach a photo of the parcel's label.
  command AttachParcelPhoto @allow(kind: admin) @allow(kind: courier, depot_id: caller.depot) {
    photo: file!
  } -> ParcelPhotoAttached

  event ParcelPhotoAttached {
    photo: file!
  }

  // opening the upload answers to AttachParcelPhoto's rules: the store,
  // not the caller, dispatches it when the bytes land
  upload ParcelPhoto {
    on uploaded -> AttachParcelPhoto
  }
}

/// One line of an order.
type OrderItem {
  /// The stock-keeping unit being bought.
  sku: string!
  quantity: int!
  price_cents: int!
}

// proves the fix end to end: windows is required, gifts is optional —
// a client omitting gifts (or sending it null) must be accepted, and
// the required list must still come out NonNull
type Fulfilment {
  windows: [FulfilmentWindow]!
  gifts: [GiftNote]?
}

type FulfilmentWindow {
  starts_at: timestamp!
}

type GiftNote {
  text: string!
}
